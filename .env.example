# Copiá este archivo a .env y completá las claves. Nunca commitees el .env real.
# Si ya tenés un .env de otro proyecto LangChain, copialo y sumá TAVILY_API_KEY.

# gemini | openai | anthropic | openrouter
# openrouter usa un modelo distinto por rol (ver clients/factory.py).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Researcher (https://app.tavily.com)
TAVILY_API_KEY=

# Job status hashes (pre-entrega 7)
REDIS_URL=redis://localhost:6379

# Phoenix (observabilidad OTEL de LangChain, pre-entrega 7)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
